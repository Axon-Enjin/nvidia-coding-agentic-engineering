#!/bin/sh
# Documentation integrity only. Does not stage or rewrite the user's work.
set -eu

if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -File scripts/fmd.ps1 check
elif command -v powershell >/dev/null 2>&1; then
    exec powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fmd.ps1 check
elif command -v python3 >/dev/null 2>&1; then
    exec python3 scripts/fmd.py check
elif command -v python >/dev/null 2>&1; then
    exec python scripts/fmd.py check
else
    echo 'Python 3 and a local FMD clone are required. See README.md for team setup.' >&2
    exit 1
fi
